# Served through VCCL Nginx /scalper/. Never put these in VITE_* variables.
PORT=5003
SCALPER_ORIGIN=http://127.0.0.1:5003
PORTAL_VERIFY_URL=http://127.0.0.1:5001/verify
# Require workspace login by default. Set true ONLY for local paper development.
LOCAL_DEMO=false
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Optional alternative to a manually generated access token:
DHAN_PIN=
DHAN_TOTP_SECRET=
# Whitelist the backend server's outbound IP in Dhan, not the browser's IP.
DHAN_STATIC_IP=
# Live order mutations remain disabled until configured deliberately.
ALLOW_LIVE_TRADING=false
MAX_ORDER_QUANTITY=5000
MAX_ORDER_NOTIONAL=500000
