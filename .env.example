# Served through VCCL Nginx /scalper/. Never put these in VITE_* variables.
PORT=5003
SCALPER_ORIGIN=http://127.0.0.1:5003
PORTAL_VERIFY_URL=http://127.0.0.1:5001/verify
# FYERS non-trading app for market data. Keep credentials server-side.
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_REDIRECT_URL=http://127.0.0.1:65534/
# Require workspace login by default. Set true ONLY for local quote preview.
LOCAL_DEMO=false
# Kite Connect app credentials and the allowed Zerodha account
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_USER_ID=
# Whitelist this backend IP in Kite Connect before enabling execution.
ZERODHA_STATIC_IP=
# Set to false for read-only use.
ALLOW_LIVE_TRADING=true
MAX_ORDER_QUANTITY=5000
MAX_ORDER_NOTIONAL=500000
