{
  "name": "vccl-scalper-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "build": "vite build",
    "check": "node --check server/index.mjs && node --check server/domain.mjs && node --check server/dhan.mjs && node --check server/instruments.mjs && node --check server/market-data.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.12"
  }
}
